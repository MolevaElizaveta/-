<Window x:Class="Moleva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Moleva"
        Title="Управление складом" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<local:PathToImageConverter x:Key="PathToImageConverter"/>
	</Window.Resources>
	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280"/>
			<ColumnDefinition Width="320"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Модуль 1: Организации -->
		<Border Grid.Column="0" BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="8" Margin="5" Padding="10" Background="#F5F5F5">
			<StackPanel>
				<TextBlock Text="ОРГАНИЗАЦИИ" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#333"/>
				<ListBox x:Name="OrganizationsList" Height="350" Margin="0,0,0,10"
                         SelectionChanged="OrganizationsList_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding OrgName}" FontSize="14" Margin="5"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Button x:Name="AddOrgBtn" Content="Добавить" Width="90" Margin="5" Click="AddOrgBtn_Click" Background="#4CAF50" Foreground="White"/>
					<Button x:Name="EditOrgBtn" Content="Редакт." Width="90" Margin="5" Click="EditOrgBtn_Click" Background="#2196F3" Foreground="White"/>
					<Button x:Name="DeleteOrgBtn" Content="Удалить" Width="90" Margin="5" Click="DeleteOrgBtn_Click" Background="#F44336" Foreground="White"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- Модуль 2: Склады -->
		<Border Grid.Column="1" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="8" Margin="5" Padding="10" Background="#F5F5F5">
			<StackPanel>
				<TextBlock Text="СКЛАДЫ" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#333"/>
				<TextBlock x:Name="SelectedOrgText" Text="Выберите организацию" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>
				<ListBox x:Name="WarehousesList" Height="280" Margin="0,0,0,10"
                         SelectionChanged="WarehousesList_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="5">
								<TextBlock Text="{Binding WhName}" FontWeight="Bold"/>
								<TextBlock Text="{Binding WhAddress}" FontSize="10" Foreground="Gray"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Button x:Name="AddWhBtn" Content="Добавить" Width="90" Margin="5" Click="AddWhBtn_Click" Background="#4CAF50" Foreground="White"/>
					<Button x:Name="EditWhBtn" Content="Редакт." Width="90" Margin="5" Click="EditWhBtn_Click" Background="#2196F3" Foreground="White"/>
					<Button x:Name="DeleteWhBtn" Content="Удалить" Width="90" Margin="5" Click="DeleteWhBtn_Click" Background="#F44336" Foreground="White"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- Модуль 3: Товары -->
		<Border Grid.Column="2" BorderBrush="#FF9800" BorderThickness="2" CornerRadius="8" Margin="5" Padding="10" Background="#F5F5F5">
			<StackPanel>
				<TextBlock Text="ТОВАРЫ" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#333"/>
				<TextBlock x:Name="SelectedWhText" Text="Выберите склад" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>

				<DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False"
                          CanUserAddRows="False" Height="280" Margin="0,0,0,10"
                          SelectionChanged="ProductsGrid_SelectionChanged"
                          AlternatingRowBackground="#E8F4FD">
					<DataGrid.Columns>
						<DataGridTemplateColumn Header="Фото" Width="60">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Image Width="40" Height="40" Source="{Binding PhotoPath, Converter={StaticResource PathToImageConverter}}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="80"/>
						<DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="130"/>
						<DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="90"/>
						<DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerName}" Width="100"/>
						<DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="100"/>
						<DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
						<DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="70"/>
						<DataGridTextColumn Header="Скидка %" Binding="{Binding DiscountPercent}" Width="70"/>
					</DataGrid.Columns>
				</DataGrid>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
					<Button x:Name="AddProductBtn" Content="Добавить" Width="80" Margin="3" Click="AddProductBtn_Click" Background="#4CAF50" Foreground="White"/>
					<Button x:Name="EditProductBtn" Content="Редакт." Width="80" Margin="3" Click="EditProductBtn_Click" Background="#2196F3" Foreground="White"/>
					<Button x:Name="DeleteProductBtn" Content="Удалить" Width="80" Margin="3" Click="DeleteProductBtn_Click" Background="#F44336" Foreground="White"/>
					<Button x:Name="ImportBtn" Content="Импорт CSV" Width="90" Margin="3" Click="ImportBtn_Click" Background="#9C27B0" Foreground="White"/>
					<Button x:Name="InvoiceBtn" Content="Накладная" Width="90" Margin="3" Click="InvoiceBtn_Click" Background="#FF9800" Foreground="White"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>